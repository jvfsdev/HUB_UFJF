rules_version = '2';

// RF02 / RF11 — validação de tipo e tamanho no servidor (o app também valida antes do envio).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.get('role', 'pendente'); }

    // Histórico escolar: só o próprio estudante envia e lê; apenas PDF até 10 MB.
    match /historicos/{userId}/{arquivo} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId
        && role() == 'estudante'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Anexos de publicações e materiais: PDF, PNG, JPG, WEBP ou MP4 até 50 MB.
    match /uploads/{userId}/{area}/{arquivo} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && role() in ['estudante', 'geral', 'externo', 'admin']
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(png|jpeg|webp)|video/mp4');
      allow delete: if signedIn() && (request.auth.uid == userId || role() == 'admin');
    }

    // Arquivos institucionais publicados pelo seed/administração.
    match /publico/{caminho=**} {
      allow read: if signedIn();
      allow write: if signedIn() && role() == 'admin';
    }
  }
}
